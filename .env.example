APP_ENV=production
DATABASE_URL=postgresql+psycopg://runwise:change-me@localhost:5432/runwise
JWT_SECRET=generate-a-random-secret-of-at-least-32-characters
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=https://your-web-domain.example
ALLOWED_HOSTS=api.your-domain.example
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_5_MIN=10

# Optional: enable signed TCHACO webhook ingestion when an official integration is provided
TCHACO_WEBHOOK_SECRET=
